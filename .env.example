# Local-only API keys. Do not commit a filled .env file.
ANTHROPIC_API_KEY=

# Optional: only needed if dedup.embedding_provider is set to "voyage" in targeting.yaml.
# By default dedup uses local (CPU) sentence-transformers embeddings and needs no Voyage key.
VOYAGE_API_KEY=

# Optional local overrides for manual runs.
SOFTROBOTICS_CONFIG=targeting.yaml
SOFTROBOTICS_DB=data/tracker.db
